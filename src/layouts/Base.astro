---
/*
 * The page frame used by every page: header, navigation, main content and footer.
 * Pagefind only indexes what is inside <main data-pagefind-body>.
 */
import '../styles/global.css';
import { REPO_URL, url } from '../lib/records';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'The public record of circles, roles, meetings, decisions and actions.' } =
  Astro.props;

// Each entry is [path under the site, label]. The home page has path ''.
const navItems: [string, string][] = [
  ['', 'Home'],
  ['circles/', 'Circles'],
  ['roles/', 'Roles'],
  ['meetings/', 'Meetings'],
  ['decisions/', 'Decisions'],
  ['actions/', 'Actions'],
  ['people/', 'People'],
  ['search/', 'Search'],
  ['about/', 'About'],
];

// Marks the current page in the menu. aria-current tells screen readers which page this is.
const isCurrent = (path: string) => {
  const here = Astro.url.pathname;
  const target = url(path);
  return path === '' ? here === target : here.startsWith(target);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Community Circles</title>
    <meta name="description" content={description} />
    <!-- An empty inline icon stops browsers asking for /favicon.ico, which this site does not have. -->
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <p class="site-title"><a href={url()}>Community Circles</a></p>
      <nav aria-label="Main">
        <ul class="nav-list">
          {
            navItems.map(([path, label]) => (
              <li>
                <a href={url(path)} aria-current={isCurrent(path) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Every change to this site is kept in its Git history, so you can see who changed what and when.{' '}
        <a href={REPO_URL}>Source code and history on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
