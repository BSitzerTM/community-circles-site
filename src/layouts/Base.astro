---
/*
 * The page frame used by every page: header, navigation, main content and footer.
 * Pagefind only indexes what is inside <main data-pagefind-body>.
 *
 * Brand images live in public/brand/ (see the README, "Brand and design").
 */
import '../styles/global.css';
import { REPO_URL, url } from '../lib/records';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'The public record of the circles, roles, meetings, decisions and actions of the Connected Community Marine Estate, Muizenberg.',
} = Astro.props;

// Each entry is [path under the site, label]. The home page has path ''.
const navItems: [string, string][] = [
  ['', 'Home'],
  ['circles/', 'Circles'],
  ['roles/', 'Roles'],
  ['meetings/', 'Meetings'],
  ['decisions/', 'Decisions'],
  ['actions/', 'Actions'],
  ['people/', 'People'],
  ['search/', 'Search'],
  ['about/', 'About'],
];

// Marks the current page in the menu. aria-current tells screen readers which page this is.
const isCurrent = (path: string) => {
  const here = Astro.url.pathname;
  const target = url(path);
  return path === '' ? here === target : here.startsWith(target);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Connected Community Marine Estate</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={url('brand/favicon.png')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <a class="brand" href={url()}>
        <img
          src={url('brand/lockup-sm.png')}
          alt="Connected Community Marine Estate, home"
          width="116"
          height="88"
        />
      </a>
      <nav aria-label="Main">
        <ul class="nav-list">
          {
            navItems.map(([path, label]) => (
              <li>
                <a href={url(path)} aria-current={isCurrent(path) ? 'page' : undefined}>
                  {path === '' ? (
                    <img class="nav-mark" src={url('brand/mark-sm.png')} alt="" width="32" height="28" />
                  ) : null}
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <!-- Decorative wave under the header, taken from the logo. -->
    <div class="wave" aria-hidden="true"></div>

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img src={url('brand/mark-sm-white.png')} alt="" width="81" height="72" />
        <img
          src={url('brand/lockup-sm-white.png')}
          alt="Connected Community Marine Estate"
          width="126"
          height="96"
        />
      </div>
      <p>
        The public record of how our neighbourhood works, kept in Git so you can see who changed what and when.{' '}
        <a href={REPO_URL}>Source code and history on GitHub</a>.
      </p>
      <p>
        <a href={url('ward45/')}>Ward 45 data report</a>
      </p>
    </footer>
  </body>
</html>
