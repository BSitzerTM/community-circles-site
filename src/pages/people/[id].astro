---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import {
  allPeople,
  allRoles,
  assetUrl,
  directory,
  formatDate,
  isOverdue,
  publicActions,
  today,
  url,
} from '../../lib/records';

// One page per person.
export async function getStaticPaths() {
  const people = await allPeople();
  return people.map((person) => ({ params: { id: person.id } }));
}

const { id } = Astro.params;
const now = today();
const dir = await directory();
const person = dir.people.find((p) => p.id === id)!;

const roles = (await allRoles()).filter((r) => r.data.holder === id);
const currentRoles = roles.filter((r) => r.data.status === 'active');
const pastRoles = roles
  .filter((r) => r.data.status === 'ended')
  .sort((a, b) => b.data.term_end.localeCompare(a.data.term_end));

// Public actions only.
const openActions = (await publicActions())
  .filter((a) => a.data.owner === id && (a.data.status === 'open' || a.data.status === 'in progress'))
  .sort((a, b) => a.data.due_date.localeCompare(b.data.due_date));
---
<Base title={person.data.name}>
  <p class="meta"><a href={url('people/')}>All people</a></p>
  <div class="person-head">
    {person.data.photo ? <img class="photo" src={assetUrl(person.data.photo)} alt="" width="112" height="112" /> : null}
    <div>
      <h1>{person.data.name}</h1>
      {person.data.bio ? <p class="lede">{person.data.bio}</p> : null}
    </div>
  </div>

  <h2>Current roles</h2>
  {
    currentRoles.length === 0 ? (
      <p class="empty">No active roles.</p>
    ) : (
      <ul>
        {currentRoles.map((r) => (
          <li>
            <a href={url(`roles/${r.id}/`)}>{r.data.title}</a> in {dir.circleName(r.data.circle)}, term ends{' '}
            {formatDate(r.data.term_end)}
          </li>
        ))}
      </ul>
    )
  }

  <h2>Open actions</h2>
  {
    openActions.length === 0 ? (
      <p class="empty">No open actions.</p>
    ) : (
      <ul class="card-list">
        {openActions.map((a) => (
          <li class="card">
            <h3>
              {a.data.title}
              {isOverdue(a.data, now) ? <Badge tone="alert">Overdue</Badge> : null}
            </h3>
            <p class="meta">
              <span>{dir.circleName(a.data.circle)}</span>
              <span>Due {formatDate(a.data.due_date)}</span>
              <span>Status: {a.data.status}</span>
            </p>
          </li>
        ))}
      </ul>
    )
  }

  {
    pastRoles.length > 0 ? (
      <>
        <h2>Past roles</h2>
        <ul>
          {pastRoles.map((r) => (
            <li>
              <a href={url(`roles/${r.id}/`)}>{r.data.title}</a> in {dir.circleName(r.data.circle)}, {formatDate(r.data.start_date)} to{' '}
              {formatDate(r.data.term_end)}
            </li>
          ))}
        </ul>
      </>
    ) : null
  }
</Base>
